    "scheduling": {
      "confirmed_state": "upcoming",
      "rule": "Session never confirmed until both parties accept",
      "transitions": [
        { "action": "client.appointments.request", "from": null, "to": "proposed" },
        { "action": "advisor propose (admin)", "from": null, "to": "proposed" },
        { "action": "client.appointments.counter", "from": ["proposed", "counter_proposed"], "to": "counter_proposed" },
        { "action": "client.appointments.accept", "from": ["proposed", "counter_proposed"], "to": "upcoming" },
        { "action": "client.appointments.cancel", "from": ["proposed", "counter_proposed", "upcoming"], "to": "cancelled" },
        { "action": "meeting start", "from": "upcoming", "to": "in_progress" },
        { "action": "meeting end (manual)", "from": "in_progress", "to": "completed" },
        { "action": "meeting end (AI)", "from": "in_progress", "to": "processing_notes" },
        { "action": "advisor publish (admin)", "from": "pending_review", "to": "published" }
      ]
    }
  },
